---
import type { Stat } from '../lib/sanity';

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-3 gap-6 text-center py-16">
  {stats.map((stat) => (
    <div>
      <p style="font-family: Raleway, sans-serif; font-size: 70px; font-weight: 700; line-height: 1; color: #ffffff;">{stat.value}</p>
      <p class="font-body text-sm md:text-base text-white/60 mt-3">
        {stat.label}
      </p>
    </div>
  ))}
</div>
