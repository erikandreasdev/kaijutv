---
/**
 * Full-screen image viewer. Include once per page; it wires itself up to every
 * `<a data-lightbox href="…">` on the page, in DOM order.
 *
 * Uses a native <dialog> so focus trapping, Esc-to-close and inertness of the
 * page behind come for free.
 */
---

<dialog
  id="kaiju-lightbox"
  class="kaiju-lightbox"
  aria-label="Visor de imágenes"
>
  <button type="button" data-lb-close class="lb-btn lb-close" aria-label="Cerrar (Esc)">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" fill="none" />
    </svg>
  </button>

  <button type="button" data-lb-prev class="lb-btn lb-prev" aria-label="Imagen anterior">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path d="M15 4L7 12l8 8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="square" />
    </svg>
  </button>

  <button type="button" data-lb-next class="lb-btn lb-next" aria-label="Imagen siguiente">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="square" />
    </svg>
  </button>

  <figure class="lb-figure">
    <img data-lb-image alt="" />
    <figcaption class="lb-caption">
      <span data-lb-caption></span>
      <span data-lb-counter class="lb-counter"></span>
    </figcaption>
  </figure>
</dialog>

<style is:global>
  .kaiju-lightbox {
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: rgba(15, 15, 15, 0.96);
    color: #fff;
    overflow: hidden;
  }

  .kaiju-lightbox::backdrop {
    background: rgba(15, 15, 15, 0.9);
  }

  .kaiju-lightbox:not([open]) {
    display: none;
  }

  .kaiju-lightbox .lb-figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 3.5rem 1rem 2rem;
  }

  .kaiju-lightbox img {
    max-width: min(1600px, 94vw);
    max-height: 82dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .kaiju-lightbox img.is-ready {
    opacity: 1;
  }

  .kaiju-lightbox .lb-caption {
    font-family: Raleway, sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: #a0a3a2;
    text-align: center;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 1.2em;
  }

  .kaiju-lightbox .lb-counter {
    color: #6e7373;
    font-variant-numeric: tabular-nums;
  }

  .kaiju-lightbox .lb-btn {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: #fff;
    background: rgba(0, 0, 0, 0.35);
    border: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .kaiju-lightbox .lb-btn:hover {
    background: #e63838;
  }

  .kaiju-lightbox .lb-btn:focus-visible {
    outline: 2px solid #e63838;
    outline-offset: 2px;
  }

  .kaiju-lightbox .lb-close {
    top: 1rem;
    right: 1rem;
  }

  .kaiju-lightbox .lb-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .kaiju-lightbox .lb-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .kaiju-lightbox[data-single='true'] .lb-prev,
  .kaiju-lightbox[data-single='true'] .lb-next,
  .kaiju-lightbox[data-single='true'] .lb-counter {
    display: none;
  }

  @media (max-width: 640px) {
    .kaiju-lightbox .lb-btn {
      width: 40px;
      height: 40px;
    }
    .kaiju-lightbox .lb-prev {
      left: 0.25rem;
    }
    .kaiju-lightbox .lb-next {
      right: 0.25rem;
    }
  }
</style>

<script>
  const root = document.getElementById('kaiju-lightbox') as HTMLDialogElement | null;
  if (root) {
    const dialog = root;
    const image = dialog.querySelector<HTMLImageElement>('[data-lb-image]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    const triggers = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'));

    let index = 0;
    let lastFocused: HTMLElement | null = null;

    dialog.dataset.single = String(triggers.length < 2);

    function show(next: number) {
      if (!triggers.length) return;
      index = (next + triggers.length) % triggers.length;
      const trigger = triggers[index];
      image.classList.remove('is-ready');
      image.src = trigger.href;
      image.alt = trigger.dataset.lbAlt || '';
      caption.textContent = trigger.dataset.lbCaption || '';
      counter.textContent = `${index + 1} / ${triggers.length}`;
      // Preload the neighbour so arrow navigation feels instant.
      const neighbour = triggers[(index + 1) % triggers.length];
      if (neighbour && neighbour !== trigger) new Image().src = neighbour.href;
    }

    image.addEventListener('load', () => image.classList.add('is-ready'));

    function open(at: number) {
      lastFocused = document.activeElement as HTMLElement;
      show(at);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    }

    triggers.forEach((trigger, i) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open(i);
      });
    });

    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));

    dialog.addEventListener('click', (event) => {
      // Clicking the empty area around the image closes the viewer.
      const target = event.target as HTMLElement;
      if (target === dialog || target.classList.contains('lb-figure')) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      }
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      image.removeAttribute('src');
      lastFocused?.focus();
    });

    // Touch swipe.
    let touchStartX = 0;
    dialog.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0].clientX;
      },
      { passive: true }
    );
    dialog.addEventListener(
      'touchend',
      (event) => {
        const delta = event.changedTouches[0].clientX - touchStartX;
        if (Math.abs(delta) > 50) show(delta < 0 ? index + 1 : index - 1);
      },
      { passive: true }
    );
  }
</script>
