---
interface Props {
  headline: string;
  subtitle: string;
}

const { headline, subtitle } = Astro.props;
---

<section class="bg-white text-black px-6 pb-16">
  <div class="max-w-[940px] mx-auto grid md:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="uppercase" style="font-family: Raleway, sans-serif; font-size: 28px; font-weight: 900; line-height: 30px; color: #ff3838;">
        {headline}
      </h1>
      <p class="font-body text-lg text-gray-600 mt-6 leading-relaxed max-w-lg">
        {subtitle}
      </p>
    </div>
    <div class="flex justify-center">
      <img
        src="/ordenador-con-video.png"
        alt="Kaiju TV - Creación de contenido audiovisual"
        class="w-full max-w-md animate-float"
        loading="eager"
      />
    </div>
  </div>
</section>
