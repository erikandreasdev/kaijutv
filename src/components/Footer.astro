---
import type { SiteSettings } from '../lib/sanity';

interface Props {
  settings?: SiteSettings | null;
}

const { settings } = Astro.props;

const email = settings?.email ?? 'info@kaiju-tv.com';
const socialLinks = settings?.socialLinks ?? [
  { _key: 'vimeo', platform: 'vimeo', url: 'https://vimeo.com/kaijutv' },
  { _key: 'instagram', platform: 'instagram', url: 'https://www.instagram.com/kaijutv/' },
  { _key: 'behance', platform: 'behance', url: 'https://www.behance.net/kaijutv' },
  { _key: 'facebook', platform: 'facebook', url: 'https://www.facebook.com/Kaiju-Tv-618382831833862/' },
];

const socialIcons: Record<string, string> = {
  vimeo: '/icons/vimeo.png',
  instagram: '/icons/instagram.png',
  behance: '/icons/behance.png',
  facebook: '/icons/facebook.png',
};
---

<footer class="bg-kaiju-red py-14 px-6">
  <div class="max-w-[940px] mx-auto flex items-center justify-between gap-6">

    <!-- Logo -->
    <a href="/">
      <img src="/kaiju-blanco.png" alt="Kaiju TV" class="h-8 w-auto" />
    </a>

    <!-- Nav links + email -->
    <div class="flex items-center gap-6 font-body text-sm">
      <a href="/aviso-legal" class="text-white/70 hover:text-white transition-colors">Legal</a>
      <span class="text-white/30">·</span>
      <a href={`mailto:${email}`} class="text-white/70 hover:text-white transition-colors">{email}</a>
    </div>

    <!-- Social icons -->
    <div class="flex items-center gap-5">
      {socialLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="opacity-60 hover:opacity-100 transition-opacity"
          aria-label={link.platform}
        >
          <img
            src={socialIcons[link.platform] ?? '/icons/vimeo.png'}
            alt={link.platform}
            class="w-6 h-6 object-contain"
          />
        </a>
      ))}
    </div>

    <!-- Attribution -->
    <a
      href="https://github.com/erikandreasdev"
      target="_blank"
      rel="noopener"
      class="font-body text-[10px] text-white/30 hover:text-white/60 transition-colors tracking-widest uppercase"
    >
      made by Erik Zephyr
    </a>

  </div>
</footer>
