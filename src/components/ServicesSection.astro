---
import type { Service } from '../lib/sanity';
import { urlFor } from '../lib/sanity';

interface Props {
  services: Service[];
}

const { services } = Astro.props;

const defaultServices = [
  {
    _id: 'default-1',
    title: 'Explainer videos',
    description: 'Videos explicativos para presentar servicios, productos o promociones.',
    order: 1,
    localIcon: '/icons/service-explainer.png',
  },
  {
    _id: 'default-2',
    title: 'Contenido para RRSS',
    description: 'Piezas para redes sociales enfocadas en generar contenido de interés para el usuario.',
    order: 2,
    localIcon: '/icons/service-rrss.png',
  },
  {
    _id: 'default-3',
    title: 'Publicidad online',
    description: 'Formatos de animación muy breves diseñados para Email marketing o Facebook Ads.',
    order: 3,
    localIcon: '/icons/service-publicidad.png',
  },
];

const displayServices = services.length > 0 ? services : defaultServices;
---

<section class="bg-kaiju-bg py-16 px-6">
  <div class="max-w-[940px] mx-auto">
    <h2 class="font-heading text-3xl uppercase text-center mb-12">
      SERVICIOS
    </h2>

    <div class="grid md:grid-cols-3 gap-8">
      {displayServices.map((svc: any) => (
        <div class="text-center p-6">
          {(svc.icon || svc.localIcon) && (
            <img
              src={svc.icon ? urlFor(svc.icon).width(80).url() : svc.localIcon}
              alt={svc.title}
              class="w-24 h-24 object-contain mx-auto mb-4 opacity-80"
            />
          )}
          <h3 class="mb-3" style="font-family: Raleway, sans-serif; font-size: 22px; font-weight: 700; color: #a0a3a2;">
            {svc.title}
          </h3>
          <p class="font-body text-gray-400 text-sm leading-relaxed">
            {svc.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
