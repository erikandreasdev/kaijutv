---
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'HOME' },
  { href: '/portfolio', label: 'PORTFOLIO' },
  { href: '/sobre-mi', label: 'SOBRE MÍ' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav class="bg-white text-black px-6 py-4 flex items-center justify-between sticky top-0 z-50 shadow-sm">
  <a href="/" class="flex-shrink-0">
    <img
      src="/kaiju-logo-loop.gif"
      alt="Kaiju TV"
      class="h-10 w-auto"
      loading="eager"
    />
  </a>

  <ul class="hidden md:flex items-center gap-8">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class={`font-heading text-sm tracking-widest transition-colors duration-200 ${
            isActive(href)
              ? 'text-kaiju-red'
              : 'text-black hover:text-kaiju-red'
          }`}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>

  <a
    href="mailto:info@kaiju-tv.com"
    class="hidden lg:block text-xs text-gray-500 hover:text-kaiju-red transition-colors font-body"
  >
    info@kaiju-tv.com
  </a>

  <!-- Mobile menu button -->
  <button
    id="mobile-menu-toggle"
    class="md:hidden flex flex-col gap-1.5 p-2"
    aria-label="Abrir menú"
  >
    <span class="block w-6 h-0.5 bg-black"></span>
    <span class="block w-6 h-0.5 bg-black"></span>
    <span class="block w-6 h-0.5 bg-black"></span>
  </button>
</nav>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="hidden md:hidden bg-white border-t border-gray-100 px-6 py-4 sticky top-[72px] z-40"
>
  <ul class="flex flex-col gap-4">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class={`font-heading text-sm tracking-widest ${
            isActive(href) ? 'text-kaiju-red' : 'text-black'
          }`}
        >
          {label}
        </a>
      </li>
    ))}
    <li>
      <a
        href="mailto:info@kaiju-tv.com"
        class="font-body text-xs text-gray-500"
      >
        info@kaiju-tv.com
      </a>
    </li>
  </ul>
</div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
