---
import MailLink from './MailLink.astro';

interface Props {
  email?: string;
}

const { email = 'info@kaiju-tv.com' } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'HOME' },
  { href: '/portfolio', label: 'PORTFOLIO' },
  { href: '/sobre-mi', label: 'SOBRE MÍ' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav
  class="relative bg-white px-6 py-5 flex items-center justify-center sticky top-0 z-50"
  aria-label="Navegación principal"
>
  <!-- Desktop: links centered -->
  <ul class="hidden md:flex items-center gap-6">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          style={isActive(href)
            ? 'letter-spacing:0.03em; color:#a0a3a2; font-weight:700; border-bottom:1px solid #6e7373; padding-bottom:2px;'
            : 'letter-spacing:0.03em; color:#a0a3a2; font-weight:700;'}
          class="font-body text-sm"
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Email pinned to the right (obfuscated against harvesters) -->
  <MailLink
    email={email}
    class="hidden lg:block absolute right-[80px] text-xs text-kaiju-red hover:text-kaiju-red-hover transition-colors font-body"
  />

  <!-- Mobile hamburger pinned to the right -->
  <button
    id="mobile-menu-toggle"
    class="md:hidden absolute right-6 flex flex-col gap-1.5 p-2"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="block w-6 h-0.5 bg-gray-500"></span>
    <span class="block w-6 h-0.5 bg-gray-500"></span>
    <span class="block w-6 h-0.5 bg-gray-500"></span>
  </button>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu" class="hidden md:hidden bg-white px-6 py-4 sticky top-[68px] z-40">
  <ul class="flex flex-col gap-4 text-center">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class={`font-body text-sm ${isActive(href) ? 'text-kaiju-red' : 'text-gray-500'}`}
          style="letter-spacing:0.03em;"
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      </li>
    ))}
    <li>
      <MailLink email={email} class="font-body text-xs text-gray-400" />
    </li>
  </ul>
</div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  });
</script>
