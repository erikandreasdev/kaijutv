---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { getSiteSettings, getProjectBySlug, getAllProjectSlugs, extractVimeoId, urlFor } from '../../lib/sanity';

export async function getStaticPaths() {
  const slugs = await getAllProjectSlugs();
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [settings, project] = await Promise.all([
  getSiteSettings(),
  getProjectBySlug(slug as string),
]);

if (!project) {
  return Astro.redirect('/portfolio');
}

const vimeoId = project.vimeoUrl ? extractVimeoId(project.vimeoUrl) : null;

const categoryLabels: Record<string, string> = {
  'motion-graphics': 'Motion Graphics',
  'branding': 'Branding',
  'explainer-video': 'Explainer Video',
  'contenido-rrss': 'Contenido RRSS',
  'publicidad-online': 'Publicidad Online',
  'broadcast-design': 'Broadcast Design',
  'brand-video': 'Brand Video',
  'otro': 'Otro',
};
---

<ProjectLayout
  title={`${project.title} — Kaiju TV`}
  description={project.description ?? `Proyecto de Kaiju TV: ${project.title}`}
  settings={settings}
>
  <article class="bg-kaiju-bg min-h-screen relative">

    <!-- Back arrow — absolute top-left, no text -->
    <a
      href="/portfolio"
      aria-label="Volver al portfolio"
      class="absolute top-5 left-5 z-10 text-kaiju-red hover:text-white transition-colors"
      style="font-size: 2rem; line-height: 1;"
    >
      &#8592;
    </a>

    <div class="max-w-[940px] mx-auto px-6 pt-14 pb-16">

      <!-- Vimeo embed -->
      {vimeoId && (
        <div class="relative w-full mb-8" style="padding-top: 56.25%">
          <iframe
            class="absolute inset-0 w-full h-full"
            src={`https://player.vimeo.com/video/${vimeoId}?color=e63838&title=0&byline=0&portrait=0`}
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            title={project.title}
          ></iframe>
        </div>
      )}

      <!-- Title (left) + Description (right) -->
      <div class="grid md:grid-cols-2 gap-10 mb-10">
        <div>
          {project.category && (
            <span class="font-body text-xs uppercase text-kaiju-red block mb-2" style="letter-spacing: 0.03em;">
              {categoryLabels[project.category] ?? project.category}
            </span>
          )}
          <h2 class="font-heading uppercase leading-tight">
            {project.title}
          </h2>
          {project.client && (
            <p class="font-body text-sm text-gray-500 mt-2 uppercase" style="letter-spacing: 0.03em;">
              {project.client}
            </p>
          )}
          {project.behanceUrl && (
            <a
              href={project.behanceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-6 border border-white/30 text-white/70 font-heading font-extrabold uppercase text-xs tracking-widest px-6 py-3 hover:border-white hover:text-white transition-colors"
            >
              Ver en Behance
            </a>
          )}
        </div>

        {project.description && (
          <div class="font-body text-gray-400 text-sm leading-relaxed">
            {project.description.split('\n').map((para) => (
              <p class="mb-3">{para}</p>
            ))}
          </div>
        )}
      </div>

      <!-- Gallery — one column, images and Vimeo embeds from Sanity -->
      {project.gallery && project.gallery.length > 0 && (
        <div class="flex flex-col gap-1">
          {project.gallery.map((item) => (
            item._type === 'vimeoItem' ? (
              <div class="relative w-full" style="padding-top: 56.25%">
                <iframe
                  class="absolute inset-0 w-full h-full"
                  src={`https://player.vimeo.com/video/${extractVimeoId(item.vimeoUrl)}?color=e63838&title=0&byline=0&portrait=0`}
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            ) : (
              <img
                src={urlFor(item).width(1880).url()}
                alt={project.title}
                class="w-full block"
                loading="lazy"
              />
            )
          ))}
        </div>
      )}

    </div>
  </article>
</ProjectLayout>
