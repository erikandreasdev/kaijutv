---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCounter from '../components/StatCounter.astro';
import { getSiteSettings, urlFor } from '../lib/sanity';

const settings = await getSiteSettings();

const defaultStats = [
  { _key: 'years', value: '7', label: 'Años de experiencia' },
  { _key: 'clients', value: '36', label: 'Clientes satisfechos' },
  { _key: 'projects', value: '+250', label: 'Proyectos acabados' },
];

const stats = settings?.aboutStats?.length ? settings.aboutStats : defaultStats;
const bio = settings?.aboutBio ?? '';
const photoUrl = settings?.aboutPhoto ? urlFor(settings.aboutPhoto).width(600).url() : null;
---

<BaseLayout
  title="Kaiju TV - Sobre Mí"
  description="Conoce a Saúl Peña, motion grapher y diseñador freelance especializado en contenido audiovisual."
  settings={settings}
>
  <!-- Bio section -->
  <section class="shadow-inset-top bg-kaiju-bg py-16 px-6">
    <div class="max-w-[940px] mx-auto">
      <h2 class="font-heading text-3xl uppercase text-center mb-10">
        ¿NOS CONOCEMOS?
      </h2>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Photo: left on desktop, top on mobile -->
        <div class="flex justify-center">
          {photoUrl ? (
            <img
              src={photoUrl}
              alt="Saúl Peña - Kaiju TV"
              class="w-full max-w-sm object-cover"
            />
          ) : (
            <div class="w-full max-w-sm aspect-[3/4] bg-kaiju-dark flex items-center justify-center">
              <p class="text-gray-600 font-body text-xs text-center px-4">
                Añade la foto en Sanity Studio
              </p>
            </div>
          )}
        </div>

        <!-- Text: right on desktop -->
        <div>
          <p class="font-body text-base text-white/90 mb-4">
            ¡Me alegra que quieras saber quién está detrás de <strong>Kaiju</strong>!
          </p>
          <div class="font-body text-white/75 leading-relaxed space-y-4 text-sm">
            {bio ? (
              bio.split('\n\n').map((para) => <p>{para}</p>)
            ) : (
              <p class="text-gray-600">Configura la biografía en Sanity Studio.</p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats section — slightly lighter shade to create visual separation -->
  <section class="bg-[#424545] px-6">
    <div class="max-w-[940px] mx-auto">
      <StatCounter stats={stats} />
    </div>
  </section>

  <div class="bg-kaiju-bg" style="height: 100px;"></div>
</BaseLayout>
