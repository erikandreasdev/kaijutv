---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import { getSiteSettings, getAllProjects } from '../lib/sanity';

const [settings, projects] = await Promise.all([
  getSiteSettings(),
  getAllProjects(),
]);
---

<BaseLayout
  title="Kaiju TV - Portfolio"
  description="Portfolio completo de Kaiju TV — motion graphics, branding, explainer videos, broadcast design y más."
  settings={settings}
>
  <section class="shadow-inset-top bg-kaiju-bg py-16 px-6">
    <div class="max-w-[940px] mx-auto">
      <h1 class="uppercase text-center mb-10" style="font-family: Raleway, sans-serif; font-size: 26px; font-weight: 900; line-height: 26px; color: #ff3838;">
        PORTFOLIO
      </h1>

      {projects.length > 0 ? (
        <PortfolioGrid projects={projects} />
      ) : (
        <div class="text-center py-24">
          <p class="text-gray-500 font-body">
            Añade proyectos en Sanity Studio para verlos aquí.
          </p>
          <a
            href="/studio"
            class="inline-block mt-6 bg-kaiju-red text-white font-heading font-extrabold uppercase tracking-widest px-8 py-3 text-sm"
          >
            IR AL STUDIO
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
