---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import TagFilter from '../components/TagFilter.astro';
import { getSiteSettings, getAllProjects, getUsedTags } from '../lib/sanity';

const [settings, projects, tags] = await Promise.all([
  getSiteSettings(),
  getAllProjects(),
  getUsedTags(),
]);
---

<BaseLayout
  title="Kaiju TV - Portfolio"
  description="Portfolio completo de Kaiju TV — motion graphics, branding, explainer videos, broadcast design y más."
  settings={settings}
>
  <section class="shadow-inset-top bg-kaiju-bg py-16 px-6">
    <div class="max-w-[940px] mx-auto">
      <h1
        class="uppercase text-center mb-4"
        style="font-family: Raleway, sans-serif; font-size: 26px; font-weight: 900; line-height: 26px; color: #ff3838;"
      >
        PORTFOLIO
      </h1>
      <p class="font-body text-sm text-center text-kaiju-dim-grey mb-10">
        {projects.length > 0
          ? `${projects.length} proyectos de animación, diseño y dirección de arte.`
          : 'Proyectos de animación, diseño y dirección de arte.'}
      </p>

      <TagFilter tags={tags} />

      {projects.length > 0 ? (
        <PortfolioGrid projects={projects} />
      ) : (
        <div class="text-center py-24">
          <p class="text-gray-500 font-body">
            Añade proyectos en Sanity Studio para verlos aquí.
          </p>
          <a
            href="/studio"
            class="inline-block mt-6 bg-kaiju-red text-white font-heading font-extrabold uppercase tracking-widest px-8 py-3 text-sm"
          >
            IR AL STUDIO
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
