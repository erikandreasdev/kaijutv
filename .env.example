# --- Sanity (required) ---
PUBLIC_SANITY_PROJECT_ID=your_project_id_here
PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_read_token_here

# --- Site (optional) ---
# Canonical origin: canonical URLs, Open Graph tags and sitemap.
PUBLIC_SITE_URL=https://kaiju-tv.com

# --- Contact form (optional) ---
# Without an endpoint the form validates and opens the visitor's mail client
# with everything pre-filled. With one, it POSTs JSON straight to the backend.
# Web3Forms:  https://api.web3forms.com/submit  (+ PUBLIC_CONTACT_ACCESS_KEY)
# Formspree:  https://formspree.io/f/xxxxxxx
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_CONTACT_ACCESS_KEY=

# Cloudflare Turnstile site key. When set, the widget replaces the built-in
# maths check. Free at dash.cloudflare.com -> Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=
